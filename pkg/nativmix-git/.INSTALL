post_install() {
    echo ""
    echo "==> NOTE: To use NativMix with an Arduino, your user must be"
    echo "    in the 'uucp' group for serial port access:"
    echo ""
    echo "      sudo usermod -aG uucp \$USER"
    echo ""
    echo "    Then log out and back in for the change to take effect."
    echo ""
}

post_upgrade() {
    post_install
}
