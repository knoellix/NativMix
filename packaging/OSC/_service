<services>
  <service name="tar_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/knoelliX/NativMix.git</param>
    <param name="revision">v1.0.17</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="filename">nativmix</param>
  </service>
  <service name="recompress">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="set_version"/>
  <service name="download_url">
    <param name="url">https://pypi.io/packages/source/m/mido/mido-1.3.2.tar.gz</param>
    <param name="filename">mido.tar.gz.bundle</param>
  </service>
</services>